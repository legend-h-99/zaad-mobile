# Zaad development environment
# Copy to .env.local for local Expo development.
# EXPO_PUBLIC_* values are bundled into the client and must be non-secret.

APP_ENV=development

EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
EXPO_PUBLIC_API_URL=http://localhost:3000
