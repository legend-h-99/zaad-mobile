# Zaad production environment
# Add these values in Cloudflare Pages production environment variables.
# EXPO_PUBLIC_* values are bundled into the client and must be non-secret.

APP_ENV=production

EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
EXPO_PUBLIC_API_URL=https://api.example.com
