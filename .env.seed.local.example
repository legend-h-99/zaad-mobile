# Local-only seed settings for Cranl Supabase.
# Copy this file to .env.seed.local, then paste values from Cranl > BaaS > Details.
# Do not commit .env.seed.local.

SUPABASE_URL=https://supabase-vuohzbgj.cranl.net
SUPABASE_SERVICE_ROLE_KEY=

# Optional but recommended for creating/updating database tables.
# Paste Cranl's Postgres "Connection string" here if available.
SUPABASE_DB_URL=
