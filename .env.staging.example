# Zaad staging environment
# Add these values in Cloudflare Pages staging/preview environment variables.
# EXPO_PUBLIC_* values are bundled into the client and must be non-secret.

APP_ENV=staging

EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
EXPO_PUBLIC_API_URL=https://api-staging.example.com
