{
  "expo": {
    "name": "زاد",
    "slug": "zaad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "zaad",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج زاد إلى الكاميرا لتصوير تقاريرك المخبرية"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج زاد إلى الوصول لمكتبة الصور لرفع تقاريرك المخبرية"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-sharing",
      "expo-splash-screen",
      "expo-apple-authentication"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sa.zaad.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "يستخدم زاد Face ID لحماية بياناتك الصحية"
      }
    },
    "android": {
      "package": "sa.zaad.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B6E4F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "zaad-app"
      }
    }
  }
}
