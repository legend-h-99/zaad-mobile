{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@supabase/supabase-js": "^2.110.6",
    "@tanstack/react-query": "^5.101.2",
    "date-fns": "^4.4.0",
    "expo": "~57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.1",
    "expo-font": "^57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-secure-store": "^57.0.1",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "jest-expo": "~57.0.2",
    "pg": "^8.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_ENV=development expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "find . -path './node_modules' -prune -o -name '._*' -type f -exec rm -f {} +",
    "build": "node scripts/run-expo-env.js production export --clear --platform web --output-dir dist",
    "build:dev": "APP_ENV=development expo export --clear --platform web --output-dir dist",
    "build:staging": "node scripts/run-expo-env.js staging export --clear --platform web --output-dir dist",
    "build:prod": "node scripts/run-expo-env.js production export --clear --platform web --output-dir dist",
    "postbuild": "node scripts/prepare-gh-pages-routes.js && find dist -name '._*' -type f -delete",
    "postbuild:dev": "node scripts/prepare-gh-pages-routes.js && find dist -name '._*' -type f -delete",
    "postbuild:staging": "node scripts/prepare-gh-pages-routes.js && find dist -name '._*' -type f -delete",
    "postbuild:prod": "node scripts/prepare-gh-pages-routes.js && find dist -name '._*' -type f -delete",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint app src __tests__ --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:coverage": "jest --coverage --runInBand"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|date-fns)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\._",
      "/\\.claude/",
      "/dist/",
      "/dist-test/"
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "src/store/**/*.ts",
      "src/constants/mealSchedule.ts",
      "scripts/database-tls.cjs"
    ],
    "coveragePathIgnorePatterns": [
      "/src/lib/supabase/client.ts$"
    ],
    "coverageReporters": [
      "text",
      "json-summary",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "private": true
}
